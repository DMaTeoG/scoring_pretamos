# ==========================================
# Backend Configuration (Django)
# ==========================================
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=scoring
DB_USER=scoring
DB_PASSWORD=scoring_password
DB_HOST=localhost
DB_PORT=5432
# Alternatively:
# DATABASE_URL=postgresql://scoring:scoring_password@localhost:5432/scoring

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Open Data / External Sources (datos.gov.co)
OPEN_DATA_APP_TOKEN=
OPEN_DATA_TIMEOUT_SECONDS=10

# ML Artifacts Directory
MODEL_ARTIFACT_DIR=ml/artifacts/

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
